# 국가법령정보센터 Open API 인증키 (OC)
# 발급: https://open.law.go.kr -> 회원가입 -> 오픈API 신청 (승인까지 1~2일 소요될 수 있음)
# 비워두면 DEMO_MODE로 동작하여 샘플 데이터로 화면을 확인할 수 있습니다.
LAW_API_OC=

# KOSHA 가이드(KOSHA GUIDE) 자동 동기화용 공공데이터포털 인증키. 위
# LAW_API_OC와는 완전히 별개의 키다. "한국산업안전보건공단_안전보건법령
# 스마트검색" API 활용신청 승인 후, 활용신청 상세페이지의 "일반 인증키"를
# 그대로 붙여넣으면 된다(Encoding/Decoding 어느 형태든 상관없음). 대시보드
# 설정 화면에서도 입력/변경할 수 있다(그쪽에서 저장하면 이 .env 값보다
# 우선한다).
KOSHA_GUIDE_API_KEY=
# 위 API의 요청 URL. 활용신청 상세페이지의 "End Point" 칸에는 서비스 URL
# (.../srch)만 나오고 뒤의 오퍼레이션 경로(/smartSearch)가 빠져 있으니
# 붙여서 써야 한다 - data.go.kr이 나중에 경로를 바꾸면 이 값을 바꿔주면 된다.
KOSHA_GUIDE_API_URL=https://apis.data.go.kr/B552468/srch/smartSearch

# run.bat/run.ps1이 서버를 띄울 포트. 비워두면(또는 이 줄을 지우면) 기본값
# 8000을 씁니다. 8000번을 못 쓰는 경우(다른 프로그램이 이미 쓰고 있거나,
# Windows에서 Hyper-V/WSL2/Docker Desktop이 그 번호를 "동적 포트 예약
# 범위"로 잡아둔 경우 - 서버가 뜨자마자 [WinError 10013] 오류로 멈추는
# 증상으로 나타남)에만 다른 번호로 바꿔서 쓰세요.
# PORT=8080

# 데이터베이스 (기본: 로컬 SQLite 파일)
# 클라우드 배포 시에는 영구 저장을 위해 Postgres 연결 문자열을 넣으세요.
# 예: postgresql://user:password@host/dbname (Neon, Render Postgres 등에서 발급)
DATABASE_URL=sqlite:///./safety_law_tracker.db

# 배포한 대시보드를 인터넷에 공개하는 경우, 아래 두 값을 모두 채우면
# 로그인(기본 인증)이 활성화됩니다. 로컬 개발 시에는 비워두세요.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# 자동 동기화 주기(시간). 0으로 두면 서버 기동 시 자동 동기화를 켜지 않고
# 수동(대시보드의 "지금 동기화" 버튼) 또는 scripts/sync_cli.py(cron)로만 동기화합니다.
AUTO_SYNC_INTERVAL_HOURS=24

# 이메일(SMTP) 알림 설정 - 비워두면 이메일 발송 기능은 비활성화됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 콤마(,)로 구분된 수신자 목록
ALERT_EMAILS=

# 안전보건 뉴스 자동 스크롤 게시판 (v2 신규) - 비워두면 아래 기본값(구글 뉴스
# 검색 RSS)이 쓰이며, 대시보드 설정 탭 "안전보건 뉴스 게시판"에서도 바꿀 수
# 있습니다(그쪽에서 저장하면 이 .env 값보다 우선합니다).
# NEWS_TICKER_ENABLED=true
# NEWS_FETCH_INTERVAL_HOURS=3
# NEWS_MAX_ITEMS_PER_CATEGORY=30
# NEWS_SOURCE_MOEL_URL=
# NEWS_SOURCE_KOSHA_URL=
# NEWS_SOURCE_ACCIDENT_URL=
